#!/usr/bin/env bash
# Keeps the ?v=<hash> cache-busting URLs in public/index.html in sync with public/assets/.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
if git diff --cached --name-only | grep -qE '^(public/|build\.mjs$)'; then
  node build.mjs >/dev/null
  git add public/index.html
fi
